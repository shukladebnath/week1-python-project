def fibonacci(n):
    print("\nFibonacci series up to", n, ":")
    a, b = 0, 1

    while a <= n:
        print(a, end=" ")
        a, b = b, a + b
    print()


def factorial(n):
    result = 1

    for i in range(1, n + 1):
        result *= i

    return result


def main():
    n = int(input("Enter a number: "))

    if n < 0:
        print("Please enter a non-negative number.")
    else:
        fibonacci(n)
        print("Factorial of", n, "is:", factorial(n))


if __name__ == "__main__":
    main()